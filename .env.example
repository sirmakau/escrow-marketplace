# ──────────────── Database ────────────────
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'

# ──────────────── Auth / JWT ────────────────
JWT_ACCESS_SECRET='replace-with-a-secure-access-secret'
JWT_REFRESH_SECRET='replace-with-a-secure-refresh-secret'
JWT_ACCESS_EXPIRES_IN=10min
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────── M-Pesa Daraja ────────────────
# Mode: mock | sandbox | production
MPESA_MODE=mock

# Sandbox / Production credentials
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_BASE_URL=https://your-ngrok.ngrok.io
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_CERT_PATH=./certs/safaricom.cer

# ──────────────── Platform ────────────────
PLATFORM_FEE_PERCENT=10
FUNDING_WINDOW_MIN=30
REVIEW_WINDOW_HOURS=48

# ──────────────── Server ────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development