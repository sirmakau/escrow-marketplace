# Client-side (Vite) configuration. Only VITE_* variables are exposed to the
# browser, so never put server secrets or private keys in this file.
#
# Empty means "same origin": in development the Vite proxy forwards /api and
# /health to the Express server, and in production Express serves this bundle.
# For Vercel, set this in the project environment variables to the Render API
# origin, for example:
# VITE_API_BASE_URL=https://escrow-marketplace-8ndh.onrender.com
VITE_API_BASE_URL=
