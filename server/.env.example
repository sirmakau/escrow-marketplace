# ──────────────── Database ────────────────
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'

# ──────────────── Auth / JWT ────────────────
JWT_ACCESS_SECRET='replace-with-a-secure-access-secret'
JWT_REFRESH_SECRET='replace-with-a-secure-refresh-secret'
JWT_ACCESS_EXPIRES_IN=10min
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────── M-Pesa Daraja ────────────────
# mock | sandbox | production
# This is the only value to change when moving from sandbox to production.
MPESA_MODE=mock

# Both credential sets can coexist in the same environment (e.g. Render).
# Only the set matching MPESA_MODE is selected.
MPESA_SANDBOX_CONSUMER_KEY=
MPESA_SANDBOX_CONSUMER_SECRET=
MPESA_SANDBOX_SHORTCODE=
MPESA_SANDBOX_PASSKEY=
MPESA_SANDBOX_INITIATOR_NAME=
MPESA_SANDBOX_INITIATOR_PASSWORD=
MPESA_SANDBOX_CERT_PATH=certs/safaricom-sandbox.cer
MPESA_SANDBOX_CERT_PEM=

MPESA_PRODUCTION_CONSUMER_KEY=
MPESA_PRODUCTION_CONSUMER_SECRET=
MPESA_PRODUCTION_SHORTCODE=
MPESA_PRODUCTION_PASSKEY=
MPESA_PRODUCTION_INITIATOR_NAME=
MPESA_PRODUCTION_INITIATOR_PASSWORD=
MPESA_PRODUCTION_CERT_PATH=certs/safaricom-production.cer
MPESA_PRODUCTION_CERT_PEM=

# Shared callback host. Must be public HTTPS for sandbox and production.
# On Render this is https://<your-service>.onrender.com
MPESA_CALLBACK_BASE_URL=https://your-service.onrender.com

# ──────────────── Platform ────────────────
PLATFORM_FEE_PERCENT=10
FUNDING_WINDOW_MIN=30
REVIEW_WINDOW_HOURS=48

# ──────────────── Server ────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://escrow-marketplace-ke.vercel.app
LOG_LEVEL=info
NODE_ENV=development
